# Database (PostgreSQL)
# For Docker: postgresql://postgres:postgres@db:5432/desti?schema=public
# For local:  postgresql://postgres:postgres@127.0.0.1:5432/desti?schema=public
DATABASE_URL="postgresql://postgres:postgres@db:5432/desti?schema=public"

# Clerk Authentication
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_YOUR_KEY_HERE
CLERK_SECRET_KEY=sk_test_YOUR_KEY_HERE

# Clerk Redirect URLs
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Mapbox Geocoding autocomplete (use a *public* `pk...` token; name must be NEXT_PUBLIC_
# so Next.js inlines it for the browser — a server-only `MAPBOX_*` var will not work here)
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=pk.YOUR_MAPBOX_PUBLIC_TOKEN_HERE
# Optional alias (same value as above), if you prefer a shorter name:
# NEXT_PUBLIC_MAPBOX_TOKEN=pk.YOUR_MAPBOX_PUBLIC_TOKEN_HERE

# Cloudflare Worker for profile picture uploads
WORKER_UPLOAD_URL=https://desti-profile-pictures.your-account.workers.dev
# Generate a strong key: openssl rand -hex 32
WORKER_UPLOAD_API_KEY=your_shared_api_key_here

# Gemini (Google AI Studio) — optional, only needed for the AI chat assistant
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
# Optional model override (default: gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# Demo geocoder (OSM Nominatim) — backend only
# Optional contact email for geocoding requests
GEOCODER_CONTACT_EMAIL=you@example.com
# Optional base URL override (default: https://nominatim.openstreetmap.org)
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
